{
  "info": {
    "name": "Navan Transaction and Invoice",
    "description": "Seed flight, hotel, rail, and Navan fee transactions, then create an invoice whose grand total is EUR 685.70. Run the Seed and invoice folder from top to bottom with the Collection Runner while the API is on http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8080"},
    {"key": "flight_id", "value": ""},
    {"key": "hotel_id", "value": ""},
    {"key": "rail_id", "value": ""},
    {"key": "trip_fee_id", "value": ""},
    {"key": "agent_fee_id", "value": ""},
    {"key": "usd_flight_id", "value": ""},
    {"key": "invoice_id", "value": ""}
  ],
  "item": [
    {
      "name": "Seed and invoice",
      "item": [
        {
          "name": "Create flight",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('201 Created', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.expect(body.type).to.eql('flight');", "pm.expect(body.metadata.coupons[0].flight_number).to.eql('BA982');", "pm.collectionVariables.set('flight_id', body.id);"]}}],
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/transactions", "body": {"mode": "raw", "raw": "{\n  \"type\": \"flight\",\n  \"external_id\": \"flight-TXL-LHR-2026-03-11\",\n  \"currency\": \"EUR\",\n  \"occurred_at\": \"2026-03-11T06:40:00Z\",\n  \"total\": 220.0,\n  \"tax_lines\": [{ \"name\": \"Airport tax\", \"amount\": 15.0 }],\n  \"fee_lines\": [{ \"name\": \"YQ\", \"amount\": 25.0 }],\n  \"metadata\": {\n    \"origin\": \"TXL\",\n    \"destination\": \"LHR\",\n    \"fare\": 180.0,\n    \"coupons\": [{\n      \"carrier\": \"BA\",\n      \"flight_number\": \"BA982\",\n      \"from\": \"TXL\",\n      \"to\": \"LHR\",\n      \"departure\": \"2026-03-11T07:00:00Z\",\n      \"arrival\": \"2026-03-11T08:20:00Z\"\n    }]\n  }\n}\n"}}
        },
        {
          "name": "Create hotel",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('201 Created', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.expect(body.metadata.address.street).to.eql('12 Kingsway');", "pm.collectionVariables.set('hotel_id', body.id);"]}}],
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/transactions", "body": {"mode": "raw", "raw": "{\n  \"type\": \"hotel\",\n  \"external_id\": \"hotel-LON-2026-03-11\",\n  \"currency\": \"EUR\",\n  \"occurred_at\": \"2026-03-11T15:00:00Z\",\n  \"total\": 331.7,\n  \"tax_lines\": [{ \"name\": \"VAT\", \"rate\": 0.07, \"amount\": 21.7 }],\n  \"fee_lines\": [],\n  \"metadata\": {\n    \"name\": \"Hotel Mitte London\",\n    \"address\": {\"street\": \"12 Kingsway\", \"city\": \"London\", \"country\": \"GB\"},\n    \"check_in\": \"2026-03-11\",\n    \"check_out\": \"2026-03-13\",\n    \"nights\": 2,\n    \"room_rate_per_night\": 140.0,\n    \"extras\": [{ \"name\": \"Breakfast\", \"amount\": 30.0 }]\n  }\n}\n"}}
        },
        {
          "name": "Create rail",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('201 Created', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.expect(body.metadata.legs).to.have.lengthOf(2);", "pm.collectionVariables.set('rail_id', body.id);"]}}],
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/transactions", "body": {"mode": "raw", "raw": "{\n  \"type\": \"rail\",\n  \"external_id\": \"rail-STP-PAR-2026-03-13\",\n  \"currency\": \"EUR\",\n  \"occurred_at\": \"2026-03-13T09:00:00Z\",\n  \"total\": 94.0,\n  \"tax_lines\": [],\n  \"fee_lines\": [{ \"name\": \"Booking fee\", \"amount\": 4.0 }],\n  \"metadata\": {\n    \"legs\": [\n      {\"origin\": \"London St Pancras\", \"destination\": \"Lille Europe\", \"departure\": \"2026-03-13T09:00:00Z\", \"arrival\": \"2026-03-13T10:30:00Z\", \"train_number\": \"EST9108\", \"class\": \"standard\"},\n      {\"origin\": \"Lille Europe\", \"destination\": \"Paris Nord\", \"departure\": \"2026-03-13T11:00:00Z\", \"arrival\": \"2026-03-13T12:05:00Z\", \"train_number\": \"EST9122\", \"class\": \"standard\"}\n    ]\n  }\n}\n"}}
        },
        {
          "name": "Create Navan trip fee",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('201 Created', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.expect(body.metadata.fee_kind).to.eql('trip_fee');", "pm.collectionVariables.set('trip_fee_id', body.id);"]}}],
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/transactions", "body": {"mode": "raw", "raw": "{\n  \"type\": \"navan_fee\",\n  \"external_id\": \"navan-trip-fee-2026-03-11\",\n  \"currency\": \"EUR\",\n  \"occurred_at\": \"2026-03-11T06:40:00Z\",\n  \"total\": 25.0,\n  \"tax_lines\": [],\n  \"fee_lines\": [],\n  \"metadata\": {\"fee_kind\": \"trip_fee\", \"description\": \"Navan trip fee\", \"related_external_id\": \"flight-TXL-LHR-2026-03-11\"}\n}\n"}}
        },
        {
          "name": "Create Navan agent call fee",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('201 Created', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.expect(body.metadata.fee_kind).to.eql('agent_call_fee');", "pm.collectionVariables.set('agent_fee_id', body.id);"]}}],
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/transactions", "body": {"mode": "raw", "raw": "{\n  \"type\": \"navan_fee\",\n  \"external_id\": \"navan-agent-call-2026-03-11\",\n  \"currency\": \"EUR\",\n  \"occurred_at\": \"2026-03-11T18:00:00Z\",\n  \"total\": 15.0,\n  \"tax_lines\": [],\n  \"fee_lines\": [],\n  \"metadata\": {\"fee_kind\": \"agent_call_fee\", \"description\": \"Agent fee for support call\", \"related_external_id\": \"hotel-LON-2026-03-11\"}\n}\n"}}
        },
        {
          "name": "Duplicate flight returns 409",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('409 Conflict', function () { pm.response.to.have.status(409); });", "const body = pm.response.json();", "pm.expect(body.error).to.eql('DUPLICATE_EXTERNAL_ID');", "pm.expect(body.existing_transaction_id).to.eql(pm.collectionVariables.get('flight_id'));"]}}],
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/transactions", "body": {"mode": "raw", "raw": "{\n  \"type\": \"flight\",\n  \"external_id\": \"flight-TXL-LHR-2026-03-11\",\n  \"currency\": \"EUR\",\n  \"occurred_at\": \"2026-03-11T06:40:00Z\",\n  \"total\": 220.0,\n  \"tax_lines\": [{ \"name\": \"Airport tax\", \"amount\": 15.0 }],\n  \"fee_lines\": [{ \"name\": \"YQ\", \"amount\": 25.0 }],\n  \"metadata\": {\"origin\": \"TXL\", \"destination\": \"LHR\", \"fare\": 180.0, \"coupons\": []}\n}\n"}}
        },
        {
          "name": "Get flight",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('200 OK', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.json().metadata.coupons[0].flight_number).to.eql('BA982');"]}}],
          "request": {"method": "GET", "header": [], "url": "{{base_url}}/transactions/{{flight_id}}"}
        },
        {
          "name": "List transactions",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('200 OK', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.expect(body.limit).to.eql(50);", "pm.expect(body.total_count).to.be.at.least(5);"]}}],
          "request": {"method": "GET", "header": [], "url": "{{base_url}}/transactions"}
        },
        {
          "name": "Create five-transaction invoice",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('201 Created', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.expect(Number(body.total)).to.eql(685.7);", "pm.expect(body.transactions).to.have.lengthOf(5);", "pm.collectionVariables.set('invoice_id', body.id);"]}}],
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/invoices", "body": {"mode": "raw", "raw": "{\n  \"transaction_ids\": [\n    \"{{flight_id}}\",\n    \"{{hotel_id}}\",\n    \"{{rail_id}}\",\n    \"{{trip_fee_id}}\",\n    \"{{agent_fee_id}}\"\n  ]\n}\n"}}
        },
        {
          "name": "Get invoice",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('200 OK', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.expect(Number(body.total)).to.eql(685.7);", "pm.expect(body.tax_rollups).to.be.an('array');", "pm.expect(body.fee_rollups).to.be.an('array');"]}}],
          "request": {"method": "GET", "header": [], "url": "{{base_url}}/invoices/{{invoice_id}}"}
        },
        {
          "name": "List invoices",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('200 OK', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.json().limit).to.eql(50);"]}}],
          "request": {"method": "GET", "header": [], "url": "{{base_url}}/invoices"}
        },
        {
          "name": "Patch invoiced flight returns 409",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('409 Conflict', function () { pm.response.to.have.status(409); });", "pm.expect(pm.response.json().error).to.eql('TRANSACTION_INVOICED');"]}}],
          "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/transactions/{{flight_id}}", "body": {"mode": "raw", "raw": "{\"total\": 999.99}\n"}}
        },
        {
          "name": "Delete invoiced flight returns 409",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('409 Conflict', function () { pm.response.to.have.status(409); });", "pm.expect(pm.response.json().error).to.eql('TRANSACTION_INVOICED');"]}}],
          "request": {"method": "DELETE", "header": [], "url": "{{base_url}}/transactions/{{flight_id}}"}
        }
      ]
    },
    {
      "name": "Invoice changes and errors",
      "item": [
        {
          "name": "Create USD flight",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('201 Created', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('usd_flight_id', pm.response.json().id);"]}}],
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/transactions", "body": {"mode": "raw", "raw": "{\n  \"type\": \"flight\",\n  \"external_id\": \"flight-JFK-SFO-2026-03-11\",\n  \"currency\": \"USD\",\n  \"occurred_at\": \"2026-03-11T12:00:00Z\",\n  \"total\": 410.0,\n  \"tax_lines\": [],\n  \"fee_lines\": [],\n  \"metadata\": {\n    \"origin\": \"JFK\",\n    \"destination\": \"SFO\",\n    \"fare\": 410.0,\n    \"coupons\": [{\"flight_number\": \"UA123\", \"from\": \"JFK\", \"to\": \"SFO\", \"departure\": \"2026-03-11T12:00:00Z\", \"arrival\": \"2026-03-11T15:20:00Z\"}]\n  }\n}\n"}}
        },
        {
          "name": "Mixed currency invoice returns 409",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('409 Conflict', function () { pm.response.to.have.status(409); });", "pm.expect(pm.response.json().error).to.eql('MIXED_CURRENCY');"]}}],
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/invoices", "body": {"mode": "raw", "raw": "{\"transaction_ids\": [\"{{flight_id}}\", \"{{usd_flight_id}}\"]}\n"}}
        },
        {
          "name": "Duplicate invoice ids return 409",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('409 Conflict', function () { pm.response.to.have.status(409); });", "pm.expect(pm.response.json().error).to.eql('DUPLICATE_TRANSACTION_IDS');"]}}],
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/invoices", "body": {"mode": "raw", "raw": "{\"transaction_ids\": [\"{{flight_id}}\", \"{{flight_id}}\"]}\n"}}
        },
        {
          "name": "Patch invoice to hotel only",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('200 OK', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.expect(Number(body.total)).to.eql(331.7);", "pm.expect(body.transactions).to.have.lengthOf(1);"]}}],
          "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/invoices/{{invoice_id}}", "body": {"mode": "raw", "raw": "{\"transaction_id\": \"{{hotel_id}}\"}\n"}}
        },
        {
          "name": "Delete invoice",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('204 No Content', function () { pm.response.to.have.status(204); });"]}}],
          "request": {"method": "DELETE", "header": [], "url": "{{base_url}}/invoices/{{invoice_id}}"}
        },
        {
          "name": "Get deleted invoice returns 404",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('404 Not Found', function () { pm.response.to.have.status(404); });", "pm.expect(pm.response.json().error).to.eql('INVOICE_NOT_FOUND');"]}}],
          "request": {"method": "GET", "header": [], "url": "{{base_url}}/invoices/{{invoice_id}}"}
        },
        {
          "name": "Patch released flight",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('200 OK', function () { pm.response.to.have.status(200); });", "pm.expect(Number(pm.response.json().total)).to.eql(210);"]}}],
          "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/transactions/{{flight_id}}", "body": {"mode": "raw", "raw": "{\"total\": 210.00}\n"}}
        },
        {
          "name": "Delete released flight",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('204 No Content', function () { pm.response.to.have.status(204); });"]}}],
          "request": {"method": "DELETE", "header": [], "url": "{{base_url}}/transactions/{{flight_id}}"}
        },
        {
          "name": "Missing transaction returns 404",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('404 Not Found', function () { pm.response.to.have.status(404); });"]}}],
          "request": {"method": "GET", "header": [], "url": "{{base_url}}/transactions/txn_missing"}
        },
        {
          "name": "limit=1000 is rejected",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });", "pm.expect(pm.response.json().error).to.eql('INVALID_PAGINATION');"]}}],
          "request": {"method": "GET", "header": [], "url": "{{base_url}}/transactions?limit=1000"}
        }
      ]
    }
  ]
}
